rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is logged in
    function loggedIn() {
      return request.auth != null;
    }

    // Profiles: Anyone authenticated can read. Only owner can write.
    match /profiles/{userId} {
      allow read: if loggedIn();
      allow write: if loggedIn() && request.auth.uid == userId;
    }

    // Transactions: Read/write only by the user who owns the transaction.
    match /spoint_transactions/{txId} {
      allow read: if loggedIn() && resource.data.user_id == request.auth.uid;
      allow create: if loggedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false; // Transactions should be immutable
    }

    // Events: Anyone authenticated can read/write.
    match /events/{eventId} {
      allow read, write: if loggedIn();
    }

    // Participants, dates, votes, messages, photos: Anyone authenticated can read/write.
    match /event_participants/{id} {
      allow read, write: if loggedIn();
    }
    match /event_dates/{id} {
      allow read, write: if loggedIn();
    }
    match /event_date_votes/{id} {
      allow read, write: if loggedIn();
    }
    match /event_messages/{id} {
      allow read, write: if loggedIn();
    }
    match /event_photos/{id} {
      allow read, write: if loggedIn();
    }

    // Challenges: Anyone authenticated can read.
    match /challenges/{id} {
      allow read: if loggedIn();
      allow write: if false; // Only admin
    }
  }
}
